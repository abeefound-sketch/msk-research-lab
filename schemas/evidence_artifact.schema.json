{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Verified Runtime Evidence Record",
  "description": "Source revision SHA and evidence files MUST exist for actual PASS records, not design fixtures.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "test_id",
    "status",
    "source_revision_sha",
    "evidence_files"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "run_id": {
      "type": "string"
    },
    "test_id": {
      "type": "string"
    },
    "status": {
      "enum": [
        "PASS",
        "FAIL",
        "BLOCKED",
        "INCONCLUSIVE",
        "NOT_TESTED",
        "SKIPPED"
      ]
    },
    "source_revision_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "environment_sha256": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "fixture_sha256": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "evidence_files": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "observed_value": {},
    "criterion": {
      "type": [
        "string",
        "null"
      ]
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "auditor_id": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}

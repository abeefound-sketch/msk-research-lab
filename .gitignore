*.token

# Upstream specimens and raw document imports (preserve .gitkeep)
# Note: Heavy upstream repos and raw copyright book uploads must not be committed to Git.
3refs/upstream/*
!3refs/upstream/.gitkeep

2data/originals/*
!2data/originals/.gitkeep

2data/snapshots/.builds/*
!2data/snapshots/.builds/.gitkeep


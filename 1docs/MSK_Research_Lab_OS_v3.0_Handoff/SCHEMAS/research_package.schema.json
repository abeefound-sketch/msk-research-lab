{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Offline Approved Research Package Manifest",
  "description": "Reject path traversal/tampered members; SHA-256 integrity does not authenticate the package sender.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "package_id",
    "snapshot_id",
    "created_at",
    "rights_review_state",
    "members"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "package_id": {
      "type": "string"
    },
    "snapshot_id": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "rights_review_state": {
      "const": "ALLOWED"
    },
    "source_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "members": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "relative_path",
          "sha256",
          "rights_status"
        ],
        "properties": {
          "relative_path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "rights_status": {
            "const": "ALLOWED"
          }
        }
      }
    },
    "manifest_sha256": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "signature": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
